vendor/wheels/
vendor/python/
dist/
imports/
logs/
uploads/
runtime/
tests/
**/.DS_Store
**/node_modules/

# Separate deployables (mobile/share Dockerfiles copy only what they need)
sharecontactsfree/
mobilecontacts/python/data/
