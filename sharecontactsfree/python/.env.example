# Copy to .env and fill in from Google Cloud Console (OAuth 2.0 Client ID, Web app)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Random secret for session cookies (openssl rand -hex 32)
APP_SECRET_KEY=
# CFS desktop uses this for POST /api/cfs/sync-contact-changes (defaults to APP_SECRET_KEY).
CFS_API_KEY=

# Where this server runs (local dev)
APP_BASE_URL=http://127.0.0.1:8080

# Link in invite emails — Share Google Contacts recipient web app (?mode=shared).
# Set to your Cloud Run service URL after deploy (deploy script updates this automatically).
PUBLIC_WEB_URL=https://share-contacts-7frzetx7sa-uc.a.run.app

# SQLite database
# Local dev:
DATABASE_PATH=./data/sharecontacts.db
# Cloud Run (deploy script mounts gs://PROJECT-share-contacts-db at /data):
# DATABASE_PATH=/data/sharecontacts.db

# Optional: Gmail send (share invites). Uses owner OAuth token.
# Set false for testing without Gmail OAuth consent — send links manually.
SEND_SHARE_EMAILS=false

# Optional: import/sync throughput (defaults are tuned for self-hosted Python, not GAS quotas)
# RECIPIENT_IMPORT_CREATE_BATCH_SIZE=200
# RECIPIENT_IMPORT_MAX_OPS_PER_LOAD=200
# RECIPIENT_IMPORT_BATCH_SIZE=200
# RECIPIENT_IMPORT_PROGRESS_BATCH_SIZE=5
# RECIPIENT_IMPORT_LARGE_GROUP_THRESHOLD=100
# RECIPIENT_IMPORT_TIME_BUDGET_MS=90000
# RECIPIENT_IMPORT_PHOTO_BATCH_SIZE=50
# RECIPIENT_IMPORT_PHOTO_FETCH_WORKERS=8
# RECIPIENT_IMPORT_PHOTO_HTTP_BATCH_SIZE=50
