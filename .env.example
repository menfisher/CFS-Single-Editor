GOOGLE_OAUTH_CLIENT_ID=your-client-id-here
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret-here
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/google/connect/callback
# Picker API key: create in the SAME Google Cloud project as your OAuth client.
# Enable "Google Picker API" for that project.
# Restrict the key to HTTP referrers, e.g. http://127.0.0.1:8000/* and http://localhost:8000/*
# GOOGLE_PICKER_APP_ID must be the project number (APIs & Services dashboard), not the OAuth client ID.
GOOGLE_PICKER_API_KEY=your-google-picker-api-key-here
GOOGLE_PICKER_APP_ID=your-google-cloud-project-number-here
# Share Google Contacts recipient web app (sharecontactsfree) — not CFS desktop, not www marketing site.
PUBLIC_WEB_URL=https://share-contacts-7frzetx7sa-uc.a.run.app
# Same secret as share app APP_SECRET_KEY / CFS_API_KEY (post-upload recipient sync).
SHARE_WEB_API_KEY=
# CFS-SE public app update feed (separate from multi-editor CFS).
CONTACTSFREESHARE_UPDATE_MANIFEST_URL=https://menfisher.github.io/contactsfreeshare-se-updates/app_update_manifest.json
