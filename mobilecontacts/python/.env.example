APP_SECRET_KEY=dev-only-change-me
# Local dev:
APP_BASE_URL=http://127.0.0.1:8090
# ngrok phone testing — use your current public URL exactly:
# APP_BASE_URL=https://your-subdomain.ngrok-free.dev
# Cloud Run — deploy script sets APP_BASE_URL automatically; use DATA_ROOT=/data in the container.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Reuse the desktop OAuth client (GOOGLE_OAUTH_CLIENT_ID). Add redirect URIs — do not replace existing ones.
# APP_BASE_URL must match one of these exactly (same host + path /auth/callback):
#   http://127.0.0.1:8090/auth/callback
#   https://your-subdomain.ngrok-free.dev/auth/callback
#   https://mobile-contacts-xxxxx-uc.a.run.app/auth/callback
#   https://mobile.contactsfreeshare.org/auth/callback
DATA_ROOT=./data
# Cloud Run deploy (from mobilecontacts/):
#   openssl rand -hex 32   # set APP_SECRET_KEY in this file first
#   bash scripts/deploy_cloud_run.sh
